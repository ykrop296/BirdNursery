  "description": "Модель генетики амадина Гульда по онлайн-калькулятору gouldianfinches.eu",
  "loci": {
    "head_color": {
      "name_ru": "Цвет головы (красный/чёрный)",
      "inheritance": "sex_linked_z",
      "alleles": {
        "R": "красный (доминантный)",
        "b": "чёрный (рецессивный)"
      },
      "note": "Самец ZZ (RR/Rb/bb), самка ZW (RY/bY). R > b."
    },
    "head_yellow": {
      "name_ru": "Жёлтая голова",
      "inheritance": "autosomal_recessive_epistatic",
      "alleles": {
        "i+": "жёлтая голова",
        "i-": "дикий тип"
      },
      "form_codes": {
        "i": "i+",
        "o": "i-"
      },
      "note": "Проявляется только при ii (i+i+) И наличии аллеля R (рецессивный эпистаз). bb+ii = чёрноголовый, генетически жёлтоголовый (ЖКК / YTB)."
    },
    "breast": {
      "name_ru": "Цвет груди",
      "inheritance": "autosomal_multiple_alleles",
      "alleles": {
        "P": "фиолетовая",
        "l": "розовая (lilac)",
        "w": "белая"
      },
      "note": "Доминирование: P > l > w. PP/Pl/Pw = фиолетовая, ll/lw = розовая, ww = белая."
    },
    "body_yellow": {
      "name_ru": "Цвет тела (зелёный/жёлтый)",
      "inheritance": "sex_linked_z_incomplete_dominant",
      "alleles": {
        "G": "зелёный (дикий тип)",
        "I": "жёлтый"
      },
      "note": "Самец: GG=зелёный, GI=жёлтый ОФ (один фактор, зелёный пастельный), II=жёлтый ДФ (два фактора, золотой). Самка: GY=зелёная, IY=жёлтая."
    },
    "body_blue": {
      "name_ru": "Синее тело (разбавление)",
      "inheritance": "autosomal_recessive",
      "alleles": {
        "m+": "синий",
        "m-": "дикий тип"
      },
      "form_codes": {
        "m": "m+",
        "o": "m-"
      },
      "note": "mm: GGmm=синий, GImm=синий пастельный ОФ, IImm=серебристый ДФ. mo = носитель (щеп. синий), фенотип не меняется."
    }
  },
